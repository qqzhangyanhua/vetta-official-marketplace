{
  "id": "cli-proxy-api",
  "name": "%name%",
  "icon": "assets/nav-icon.png",
  "version": "1.10.3",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "cli_proxy_api",
    "expose": "./plugin"
  },
  "permissions": [
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "models.manage",
    "media.provider.register",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "proxy",
        "runtime": {
          "version": "7.3.17+gemini.1.0.5",
          "platforms": {
            "win32-x64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "3a036376a7c04a8fe70d7335915aa79cc520f8fad72030ef8da43a64e50bc38b",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "e712e4f2a6972b7a692c32fbc8cdf839fcde29428acc9ad98e26ff7212ac24ee",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "win32-arm64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "99fb4d3bdfc8d2e2002f2fb4d2c0b5d724cefe60d0c1c110f7e00cd8a49ef0ad",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "80b229c61d10cb34c0279beb93190411d48b055c9bd6f67248c4069ee4f08caa",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "37f6b9767d2820d96095f5a792041b6c11dcd7420023aa2c3fe1769aaeff6612",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "575c8c5663df54dd6f9132f69795e5297967b5cee0ff500b585f866b1a5cd710",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "59bca8a23938216eab42380362424a109986df20c70d5f552948d3dfeb3c7820",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "3c771ff57e607b40bf95753e0ad2fb01127a296fe4cbff79b49116cd2327b5bb",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "1c9aef78dcd372775ccd5252bd0f383366c93c1fa552204df8ea9191fa130927",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "b0b202ff9466c6e1f7170577b9a0eb6bd1f5d8069747fce215583faebd3fab73",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "65a250f749222eee88d949e94efd88c9a9640728e01ae83e1353bac591487e3f",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "4e792bd079c2e1bae0134ee5e009317dbff8439d8fbed808aefb84dc44eb098c",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            }
          }
        },
        "credentials": [
          {
            "id": "api-key",
            "bytes": 32
          },
          {
            "id": "management-key",
            "bytes": 32
          }
        ],
        "templates": [
          {
            "source": "dist/assets/config.yaml.tpl",
            "destination": "config.yaml",
            "mode": "render"
          }
        ],
        "process": {
          "args": [
            "--config",
            "${VETTA_SERVICE_CACHE_DIR}/config.yaml"
          ]
        },
        "health": {
          "path": "/v1/models",
          "credentialId": "api-key",
          "timeoutMs": 60000,
          "readiness": {
            "mode": "plugin"
          }
        }
      }
    ]
  },
  "description": "%description%",
  "author": "Vetta / Router For Me",
  "defaultLocale": "en"
}
