{
  "id": "cli-proxy-api",
  "name": "%name%",
  "icon": "assets/nav-icon.png",
  "version": "1.10.3",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "cli_proxy_api",
    "expose": "./plugin"
  },
  "permissions": [
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "models.manage",
    "media.provider.register",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "proxy",
        "runtime": {
          "version": "8.0.13+gemini.1.0.5",
          "platforms": {
            "win32-x64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "7064ec8150511d0ece145a492968b476aa5abae3e1c7ef385852631918086bdd",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "e712e4f2a6972b7a692c32fbc8cdf839fcde29428acc9ad98e26ff7212ac24ee",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "win32-arm64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "ec1ea1cc76964d0a9d68fd0c989a9d9f579911f08fa902663259adb1e9e6df4c",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "80b229c61d10cb34c0279beb93190411d48b055c9bd6f67248c4069ee4f08caa",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "8c47459190b997828be246973d18fbb681799540cebb867c3b7368d189559785",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "575c8c5663df54dd6f9132f69795e5297967b5cee0ff500b585f866b1a5cd710",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "652a192e3e38520253e330c4a094fa8916728370c3f213f127dbc56e35be7938",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "3c771ff57e607b40bf95753e0ad2fb01127a296fe4cbff79b49116cd2327b5bb",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "50ecffb47fdd81c8c5a9825a73a7a905ab66342337e274f39c4276b92d3533f3",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "b0b202ff9466c6e1f7170577b9a0eb6bd1f5d8069747fce215583faebd3fab73",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "f7ff98a128075ea8437dadd58a88f429a401e452a42ef7119304139185f5344f",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "4e792bd079c2e1bae0134ee5e009317dbff8439d8fbed808aefb84dc44eb098c",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            }
          }
        },
        "credentials": [
          {
            "id": "api-key",
            "bytes": 32
          },
          {
            "id": "management-key",
            "bytes": 32
          }
        ],
        "templates": [
          {
            "source": "dist/assets/config.yaml.tpl",
            "destination": "config.yaml",
            "mode": "render"
          }
        ],
        "process": {
          "args": [
            "--config",
            "${VETTA_SERVICE_CACHE_DIR}/config.yaml"
          ]
        },
        "health": {
          "path": "/v1/models",
          "credentialId": "api-key",
          "timeoutMs": 60000,
          "readiness": {
            "mode": "plugin"
          }
        }
      }
    ]
  },
  "description": "%description%",
  "author": "Vetta / Router For Me",
  "defaultLocale": "en"
}
