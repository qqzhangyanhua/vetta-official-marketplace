{
  "id": "cli-proxy-api",
  "name": "%name%",
  "icon": "assets/nav-icon.png",
  "version": "1.10.3",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "cli_proxy_api",
    "expose": "./plugin"
  },
  "permissions": [
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "models.manage",
    "media.provider.register",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "proxy",
        "runtime": {
          "version": "8.0.10+gemini.1.0.5",
          "platforms": {
            "win32-x64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "d73c3b78faeb9d4c6e80890f0242146557a5032dfbb788474d06cdb64544b325",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "e712e4f2a6972b7a692c32fbc8cdf839fcde29428acc9ad98e26ff7212ac24ee",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "win32-arm64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "fb8d120664f85dc91bfcea056d8995486e90f9b0d5d18ddcee6ad0053957f62c",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "80b229c61d10cb34c0279beb93190411d48b055c9bd6f67248c4069ee4f08caa",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "2d5af1cf19cc0d887b96fde809f78a999438a65564ce19de5966b7d5b6c451ca",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "575c8c5663df54dd6f9132f69795e5297967b5cee0ff500b585f866b1a5cd710",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "e2080f54ee4d7940c77345440956ce592eef34da2910bd865d4928b75accd122",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "3c771ff57e607b40bf95753e0ad2fb01127a296fe4cbff79b49116cd2327b5bb",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "6211e059951e83acffedac098ad44a8bc60b47a53988c8d34d44397bfabbf578",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "b0b202ff9466c6e1f7170577b9a0eb6bd1f5d8069747fce215583faebd3fab73",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "80aa0615d5d538c1988542ab99bc2d9a7b46360814c0f8c93db9e30127e249ff",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "4e792bd079c2e1bae0134ee5e009317dbff8439d8fbed808aefb84dc44eb098c",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            }
          }
        },
        "credentials": [
          {
            "id": "api-key",
            "bytes": 32
          },
          {
            "id": "management-key",
            "bytes": 32
          }
        ],
        "templates": [
          {
            "source": "dist/assets/config.yaml.tpl",
            "destination": "config.yaml",
            "mode": "render"
          }
        ],
        "process": {
          "args": [
            "--config",
            "${VETTA_SERVICE_CACHE_DIR}/config.yaml"
          ]
        },
        "health": {
          "path": "/v1/models",
          "credentialId": "api-key",
          "timeoutMs": 60000,
          "readiness": {
            "mode": "plugin"
          }
        }
      }
    ]
  },
  "description": "%description%",
  "author": "Vetta / Router For Me",
  "defaultLocale": "en"
}
