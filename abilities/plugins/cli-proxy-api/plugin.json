{
  "id": "cli-proxy-api",
  "name": "%name%",
  "icon": "assets/nav-icon.png",
  "version": "1.10.3",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "cli_proxy_api",
    "expose": "./plugin"
  },
  "permissions": [
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "models.manage",
    "media.provider.register",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "proxy",
        "runtime": {
          "version": "8.0.8+gemini.1.0.5",
          "platforms": {
            "win32-x64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "278447a084cc119f4c94a044539d7f843b6f2a5e1b356fb1770e537633ab97b6",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "e712e4f2a6972b7a692c32fbc8cdf839fcde29428acc9ad98e26ff7212ac24ee",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "win32-arm64": {
              "executable": "core/cli-proxy-api.exe",
              "artifacts": [
                {
                  "sha256": "8cd5e083fc88c3757df8c3bdf7c0a165cdc0b56f0fa34161785505e0f8e18005",
                  "archive": "zip",
                  "destination": "core"
                },
                {
                  "sha256": "80b229c61d10cb34c0279beb93190411d48b055c9bd6f67248c4069ee4f08caa",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "6549a010e18f34a5d70464f1ef7cf5506ef43b0e260b266cc0869fe519fb9d34",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "575c8c5663df54dd6f9132f69795e5297967b5cee0ff500b585f866b1a5cd710",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "df48fe6a6e5c60d1966ed374e6b0567cb8c87180df9dd14dfb25f42365b4bb25",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "3c771ff57e607b40bf95753e0ad2fb01127a296fe4cbff79b49116cd2327b5bb",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-x64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "0b97f31ad5fd357928c7278545c01ade4dfb96a022c31135239082807df68407",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "b0b202ff9466c6e1f7170577b9a0eb6bd1f5d8069747fce215583faebd3fab73",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            },
            "linux-arm64": {
              "executable": "core/cli-proxy-api",
              "artifacts": [
                {
                  "sha256": "781224691d50a4107b0132326fa58e246d34ef98e65649db02fe1a3eb1e2cc60",
                  "archive": "tar.gz",
                  "destination": "core"
                },
                {
                  "sha256": "4e792bd079c2e1bae0134ee5e009317dbff8439d8fbed808aefb84dc44eb098c",
                  "archive": "zip",
                  "destination": "plugins"
                }
              ]
            }
          }
        },
        "credentials": [
          {
            "id": "api-key",
            "bytes": 32
          },
          {
            "id": "management-key",
            "bytes": 32
          }
        ],
        "templates": [
          {
            "source": "dist/assets/config.yaml.tpl",
            "destination": "config.yaml",
            "mode": "render"
          }
        ],
        "process": {
          "args": [
            "--config",
            "${VETTA_SERVICE_CACHE_DIR}/config.yaml"
          ]
        },
        "health": {
          "path": "/v1/models",
          "credentialId": "api-key",
          "timeoutMs": 60000,
          "readiness": {
            "mode": "plugin"
          }
        }
      }
    ]
  },
  "description": "%description%",
  "author": "Vetta / Router For Me",
  "defaultLocale": "en"
}
